{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyM79sPImpe5ZyWS9fUn+/c5"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"6m_rLalbIuUw","executionInfo":{"status":"ok","timestamp":1794493498269,"user_tz":-330,"elapsed":157864,"user":{"displayName":"MAHALAKSHMI K","userId":"06223343692658849191"}},"outputId":"63d66cf1-8104-44e2-c6aa-bc69970da576"},"outputs":[{"output_type":"stream","name":"stdout","text":["RESPONSIBLE AI AUDIT STARTED\n","\n","DATASET CREATED\n","Total records: 400000\n","Number of sites: 15\n","\n","DATA CLEANING COMPLETED\n","Remaining missing values: 8003\n","\n","DATASET INFORMATION\n","   site_id  month  water_litres  gender age_group region language unit  \\\n","0   Site_2     10   2298.566880  Female     31-45   West    Hindi  MWh   \n","1  Site_12      5   4506.734718    Male       46+   East    Hindi  MWh   \n","2  Site_10     11   2692.357691  Female       46+  North  English  kWh   \n","3   Site_7      5   3768.863585    Male     31-45   East  English  kWh   \n","4   Site_7      5   2290.251234  Female       46+  North  English  kWh   \n","\n","   meter_reading  diesel_litres  energy_consumption  electricity_kwh  \\\n","0       8.767052     255.965665        10527.946515      8767.051727   \n","1       1.410683      12.873195         1509.905634      1410.683420   \n","2    1145.923412     369.134398         4705.354014      1145.923412   \n","3    7273.762458     145.811688         8775.164660      7273.762458   \n","4    2784.098087     205.301444         4661.895397      2784.098087   \n","\n","   meter_missing  diesel_missing  emission_factor_year  emission_factor  \\\n","0              0               1                  2021          0.00078   \n","1              0               0                  2024          0.00070   \n","2              0               0                  2022          0.00075   \n","3              0               0                  2022          0.00075   \n","4              0               0                  2022          0.00075   \n","\n","   emissions_kg  \n","0      8.211798  \n","1      1.056934  \n","2      3.529016  \n","3      6.581373  \n","4      3.496422  \n","               month   water_litres  meter_reading  diesel_litres  \\\n","count  400000.000000  400000.000000  391997.000000  400000.000000   \n","mean        6.499725    2750.305776    4401.385763     254.679656   \n","std         3.449457    1298.675464    3199.315317     135.750059   \n","min         1.000000     500.000563       1.000075      10.001704   \n","25%         4.000000    1626.035320    1559.542500     142.801507   \n","50%         7.000000    2749.543468    4372.734286     254.158831   \n","75%         9.000000    3875.471919    7190.657771     366.625520   \n","max        12.000000    4999.991914    9999.997587     499.999321   \n","\n","       energy_consumption  electricity_kwh  meter_missing  diesel_missing  \\\n","count       400000.000000    400000.000000  400000.000000   400000.000000   \n","mean          8011.984258      5498.824792       0.020008        0.080555   \n","std           2955.459464      2573.654755       0.140026        0.272151   \n","min            558.311785      1000.032336       0.000000        0.000000   \n","25%           5752.695397      3291.697815       0.000000        0.000000   \n","50%           8016.938739      5498.994957       0.000000        0.000000   \n","75%          10270.000856      7709.975293       0.000000        0.000000   \n","max          15495.986655      9999.997587       1.000000        1.000000   \n","\n","       emission_factor_year  emission_factor   emissions_kg  \n","count         400000.000000    400000.000000  400000.000000  \n","mean            2022.000503         0.000754       6.040980  \n","std                1.414405         0.000043       2.258074  \n","min             2020.000000         0.000700       0.401984  \n","25%             2021.000000         0.000720       4.318118  \n","50%             2022.000000         0.000750       6.024789  \n","75%             2023.000000         0.000780       7.738409  \n","max             2024.000000         0.000820      12.448230  \n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","TRAINING DATA: (300000, 29)\n","TEST DATA: (100000, 29)\n","\n","REGRESSION RESULTS\n","MAE: 264.772\n","RMSE: 562.243\n","R2 Score: 0.9638\n","\n","CLASSIFICATION MODEL TRAINED\n","Baseline accuracy: 0.9408\n","\n","FAIRNESS BEFORE MITIGATION\n","Attribute  Demographic_Parity_Gap  Equal_Opportunity_Gap  Calibration_Gap\n","   gender                0.005326               0.002350         0.002831\n","age_group                0.003545               0.003485         0.000956\n","   region                0.045180               0.005889         0.003575\n"," language                0.013094               0.007572         0.006857\n","\n","LARGEST GAP\n","Attribute: region\n","Metric: Demographic Parity\n","Gap: 0.04517952405607145\n","\n","FAIRNESS AFTER MITIGATION\n","Attribute  Demographic_Parity_Gap  Equal_Opportunity_Gap  Calibration_Gap\n","   gender                0.003927               0.003345         0.001141\n","age_group                0.004001               0.004902         0.000443\n","   region                0.025552               0.043005         0.006132\n"," language                0.018438               0.025070         0.000600\n","\n","MITIGATION RESULTS\n","Before accuracy: 0.94078\n","After accuracy: 0.96265\n","Accuracy loss (%): -2.324666765875131\n","Fairness gap reduction (%): 43.443279049344085\n","Acceptance criteria met: True\n","\n","GENERATING SHAP EXPLANATIONS\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x630 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x750 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","TOP IMPORTANT FEATURES\n","         Feature  Importance\n"," electricity_kwh    0.785345\n","   diesel_litres    0.210040\n","     region_East    0.000913\n","     region_West    0.000847\n","    region_North    0.000486\n","    water_litres    0.000466\n","    region_South    0.000454\n","language_English    0.000365\n","   meter_missing    0.000321\n","           month    0.000243\n"," emission_factor    0.000135\n","  diesel_missing    0.000096\n","  language_Hindi    0.000090\n","  language_Other    0.000030\n","  site_id_Site_7    0.000022\n","\n","RED TEAM RESULTS\n"," Test_Case                 Scenario Validation_Result                  Issues\n","         1     Negative electricity           FLAGGED     Invalid electricity\n","         2      Extreme electricity           FLAGGED     Extreme electricity\n","         3         Zero electricity           CHECKED      No validation flag\n","         4      Missing electricity           FLAGGED     Invalid electricity\n","         5           Negative water           FLAGGED           Invalid water\n","         6            Extreme water           CHECKED      No validation flag\n","         7               Zero water           CHECKED      No validation flag\n","         8          Negative diesel           FLAGGED          Invalid diesel\n","         9           Extreme diesel           CHECKED      No validation flag\n","        10           Missing diesel           FLAGGED          Invalid diesel\n","        11               Month zero           FLAGGED           Invalid month\n","        12           Month thirteen           FLAGGED           Invalid month\n","        13         January boundary           CHECKED      No validation flag\n","        14        December boundary           CHECKED      No validation flag\n","        15 Negative emission factor           FLAGGED Invalid emission factor\n","        16  Extreme emission factor           CHECKED      No validation flag\n","        17  Missing emission factor           FLAGGED Invalid emission factor\n","        18      Invalid diesel flag           FLAGGED            Invalid flag\n","        19       Invalid meter flag           FLAGGED            Invalid flag\n","        20            Unseen region           FLAGGED        Unknown category\n","        21          Unseen language           FLAGGED        Unknown category\n","        22              Unseen site           FLAGGED        Unknown category\n","        23          All zero energy           CHECKED      No validation flag\n","        24         Duplicate record           FLAGGED        Duplicate record\n","        25         High electricity           FLAGGED     Extreme electricity\n","        26              Zero diesel           CHECKED      No validation flag\n","        27     Zero emission factor           CHECKED      No validation flag\n","        28     Very low electricity           CHECKED      No validation flag\n","        29         High diesel flag           CHECKED      No validation flag\n","        30          High meter flag           CHECKED      No validation flag\n","Total test cases: 30\n","\n","RISK REGISTER\n","                      Risk Impact                                     Control                 Owner\n"," Demographic data exposure   High     Data minimisation and restricted access       Privacy Officer\n","       Unauthorised access   High            Encryption and role-based access         Security Lead\n","         AI discrimination   High                    Regular fairness testing   Responsible AI Lead\n","  Incorrect meter readings   High            Meter validation and unit checks Data Engineering Lead\n","Incorrect emission factors   High Verified factor sources and version control   Sustainability Lead\n","         Prediction errors Medium             Model monitoring and validation           ML Engineer\n","        Model manipulation Medium       Input validation and security testing         Security Lead\n","     Unexplained decisions Medium                       SHAP and human review    AI Governance Lead\n","  Excessive data retention Medium      Retention schedule and secure deletion       Privacy Officer\n","     BRSR reporting errors   High       Evidence checks and compliance review       Compliance Lead\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","====================================\n","RESPONSIBLE AI AUDIT COMPLETED\n","====================================\n","Records: 400000\n","Sites: 15\n","Fairness gap reduction: 43.44 %\n","Accuracy loss: -2.32 %\n","Acceptance criteria: True\n","\n","PROJECT FILES CREATED:\n","['shap_global.png', 'synthetic_dataset.csv', 'fairness_after.csv', 'fairness_before.csv', 'site_energy.png', 'energy_prediction_model.pkl', 'fairness_gap_comparison.csv', 'feature_importance.csv', 'baseline_classifier.pkl', 'mitigated_classifier.pkl', 'audit_summary.txt', 'risk_register.csv', 'red_team_results.csv', 'model_card.txt', 'shap_local.png', 'fairness_comparison.png']\n","\n","Download ZIP file in Google Colab:\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_392f1c01-4d1e-4a4a-aa6e-4a7efde026b0\", \"Responsible_AI_Sustainability_Audit.zip\", 32665485)"]},"metadata":{}}],"source":["\n","\n","# ============================================================\n","# RESPONSIBLE AI SUSTAINABILITY AUDIT\n","# Complete Beginner-Friendly Project\n","# Synthetic Dataset | 400,000 Records | 15 Sites\n","# ============================================================\n","\n","# 1. INSTALL AND IMPORT LIBRARIES\n","\n","import sys\n","import subprocess\n","\n","subprocess.check_call([\n","    sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n","    \"pandas\", \"numpy\", \"scikit-learn\",\n","    \"matplotlib\", \"shap\"\n","])\n","\n","import os\n","import warnings\n","import shutil\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import joblib\n","import shap\n","\n","from sklearn.model_selection import train_test_split\n","from sklearn.ensemble import RandomForestRegressor, RandomForestClassifier\n","from sklearn.metrics import (\n","    mean_absolute_error,\n","    mean_squared_error,\n","    r2_score,\n","    accuracy_score,\n","    balanced_accuracy_score\n",")\n","\n","warnings.filterwarnings(\"ignore\")\n","np.random.seed(42)\n","\n","os.makedirs(\"audit_outputs\", exist_ok=True)\n","\n","print(\"RESPONSIBLE AI AUDIT STARTED\")\n","\n","\n","# 2. GENERATE SYNTHETIC DATASET\n","\n","N = 400000\n","rng = np.random.default_rng(42)\n","\n","df = pd.DataFrame({\n","    \"site_id\": rng.choice(\n","        [f\"Site_{i}\" for i in range(1, 16)], N\n","    ),\n","    \"month\": rng.integers(1, 13, N),\n","    \"water_litres\": rng.uniform(500, 5000, N),\n","    \"gender\": rng.choice(\n","        [\"Male\", \"Female\", \"Other\"], N\n","    ),\n","    \"age_group\": rng.choice(\n","        [\"18-30\", \"31-45\", \"46+\"], N\n","    ),\n","    \"region\": rng.choice(\n","        [\"North\", \"South\", \"East\", \"West\"], N\n","    ),\n","    \"language\": rng.choice(\n","        [\"Hindi\", \"English\", \"Other\"], N\n","    )\n","})\n","\n","# Generate electricity readings\n","\n","true_electricity = rng.uniform(1000, 10000, N)\n","\n","df[\"unit\"] = rng.choice(\n","    [\"kWh\", \"MWh\"], N, p=[0.8, 0.2]\n",")\n","\n","df[\"meter_reading\"] = np.where(\n","    df[\"unit\"] == \"MWh\",\n","    true_electricity / 1000,\n","    true_electricity\n",")\n","\n","# Introduce missing meter readings\n","\n","df.loc[\n","    rng.random(N) < 0.02, \"meter_reading\"\n","] = np.nan\n","\n","# Generate diesel records\n","\n","true_diesel = rng.uniform(10, 500, N)\n","\n","df[\"diesel_litres\"] = true_diesel.copy()\n","\n","df.loc[\n","    rng.random(N) < 0.08, \"diesel_litres\"\n","] = np.nan\n","\n","# Artificial proxy effects for fairness demonstration\n","\n","region_effect = df[\"region\"].map({\n","    \"North\": 100,\n","    \"South\": -100,\n","    \"East\": 200,\n","    \"West\": -200\n","})\n","\n","language_effect = df[\"language\"].map({\n","    \"Hindi\": 100,\n","    \"English\": -100,\n","    \"Other\": 50\n","})\n","\n","# Generate energy target\n","\n","df[\"energy_consumption\"] = (\n","    true_electricity\n","    + true_diesel * 9.8\n","    + region_effect\n","    + language_effect\n","    + rng.normal(0, 150, N)\n",").clip(lower=0)\n","\n","print(\"\\nDATASET CREATED\")\n","print(\"Total records:\", len(df))\n","print(\"Number of sites:\", df[\"site_id\"].nunique())\n","\n","\n","# 3. DATA CLEANING\n","\n","df[\"electricity_kwh\"] = np.where(\n","    df[\"unit\"] == \"MWh\",\n","    df[\"meter_reading\"] * 1000,\n","    df[\"meter_reading\"]\n",")\n","\n","df[\"meter_missing\"] = (\n","    df[\"electricity_kwh\"].isna().astype(int)\n",")\n","\n","df[\"diesel_missing\"] = (\n","    df[\"diesel_litres\"].isna().astype(int)\n",")\n","\n","# Fill missing readings using site medians\n","\n","for column in [\"electricity_kwh\", \"diesel_litres\"]:\n","    df[column] = (\n","        df.groupby(\"site_id\")[column]\n","        .transform(lambda x: x.fillna(x.median()))\n","    )\n","    df[column] = df[column].fillna(df[column].median())\n","\n","# Emission factors: illustrative synthetic values\n","\n","emission_factors = {\n","    2020: 0.00082,\n","    2021: 0.00078,\n","    2022: 0.00075,\n","    2023: 0.00072,\n","    2024: 0.00070\n","}\n","\n","df[\"emission_factor_year\"] = rng.choice(\n","    list(emission_factors.keys()), N\n",")\n","\n","df[\"emission_factor\"] = (\n","    df[\"emission_factor_year\"].map(emission_factors)\n",")\n","\n","df[\"emissions_kg\"] = (\n","    df[\"energy_consumption\"] * df[\"emission_factor\"]\n",")\n","\n","print(\"\\nDATA CLEANING COMPLETED\")\n","print(\"Remaining missing values:\", df.isnull().sum().sum())\n","\n","\n","# 4. EXPLORATORY DATA ANALYSIS\n","\n","print(\"\\nDATASET INFORMATION\")\n","print(df.head())\n","print(df.describe())\n","\n","df.groupby(\"site_id\")[\n","    \"energy_consumption\"\n","].mean().plot(kind=\"bar\", figsize=(10, 5))\n","\n","plt.title(\"Average Energy Consumption by Site\")\n","plt.ylabel(\"Energy Consumption (kWh)\")\n","plt.tight_layout()\n","plt.savefig(\"audit_outputs/site_energy.png\")\n","plt.show()\n","\n","\n","# 5. PREPARE MACHINE LEARNING DATA\n","\n","features = [\n","    \"electricity_kwh\",\n","    \"water_litres\",\n","    \"diesel_litres\",\n","    \"diesel_missing\",\n","    \"meter_missing\",\n","    \"month\",\n","    \"emission_factor\",\n","    \"site_id\",\n","    \"region\",\n","    \"language\"\n","]\n","\n","X = pd.get_dummies(\n","    df[features],\n","    columns=[\"site_id\", \"region\", \"language\"],\n","    dtype=int\n",")\n","\n","y = df[\"energy_consumption\"]\n","\n","# Split indices to maintain correct group alignment\n","\n","train_idx, test_idx = train_test_split(\n","    np.arange(N),\n","    test_size=0.25,\n","    random_state=42\n",")\n","\n","X_train = X.iloc[train_idx]\n","X_test = X.iloc[test_idx]\n","\n","y_train = y.iloc[train_idx]\n","y_test = y.iloc[test_idx]\n","\n","print(\"\\nTRAINING DATA:\", X_train.shape)\n","print(\"TEST DATA:\", X_test.shape)\n","\n","\n","# 6. TRAIN ENERGY PREDICTION MODEL\n","\n","regression_model = RandomForestRegressor(\n","    n_estimators=30,\n","    max_depth=12,\n","    min_samples_leaf=20,\n","    random_state=42,\n","    n_jobs=-1\n",")\n","\n","regression_model.fit(X_train, y_train)\n","\n","energy_predictions = regression_model.predict(X_test)\n","\n","mae = mean_absolute_error(y_test, energy_predictions)\n","\n","rmse = np.sqrt(\n","    mean_squared_error(y_test, energy_predictions)\n",")\n","\n","r2 = r2_score(y_test, energy_predictions)\n","\n","print(\"\\nREGRESSION RESULTS\")\n","print(\"MAE:\", round(mae, 3))\n","print(\"RMSE:\", round(rmse, 3))\n","print(\"R2 Score:\", round(r2, 4))\n","\n","\n","# 7. CLASSIFICATION MODEL FOR FAIRNESS TESTING\n","\n","# High consumption = top 25% of energy observations\n","\n","threshold = y.quantile(0.75)\n","\n","y_class = (y >= threshold).astype(int)\n","\n","yc_train = y_class.iloc[train_idx]\n","yc_test = y_class.iloc[test_idx]\n","\n","classifier = RandomForestClassifier(\n","    n_estimators=30,\n","    max_depth=12,\n","    min_samples_leaf=20,\n","    class_weight=\"balanced\",\n","    random_state=42,\n","    n_jobs=-1\n",")\n","\n","classifier.fit(X_train, yc_train)\n","\n","probabilities = classifier.predict_proba(X_test)[:, 1]\n","\n","baseline_predictions = (\n","    probabilities >= 0.5\n",").astype(int)\n","\n","print(\"\\nCLASSIFICATION MODEL TRAINED\")\n","\n","print(\n","    \"Baseline accuracy:\",\n","    round(accuracy_score(yc_test, baseline_predictions), 4)\n",")\n","\n","\n","# 8. FAIRNESS TESTING\n","\n","sensitive_attributes = [\n","    \"gender\",\n","    \"age_group\",\n","    \"region\",\n","    \"language\"\n","]\n","\n","groups = df.iloc[test_idx][\n","    sensitive_attributes\n","].reset_index(drop=True)\n","\n","actual = yc_test.to_numpy()\n","\n","\n","def fairness_report(actual, predictions, scores, groups):\n","\n","    rows = []\n","\n","    for attribute in sensitive_attributes:\n","\n","        for group in groups[attribute].unique():\n","\n","            mask = (\n","                groups[attribute].to_numpy() == group\n","            )\n","\n","            a = actual[mask]\n","            p = predictions[mask]\n","            s = scores[mask]\n","\n","            tpr = (\n","                p[a == 1].mean()\n","                if np.any(a == 1) else np.nan\n","            )\n","\n","            calibration_error = abs(\n","                s.mean() - a.mean()\n","            )\n","\n","            rows.append({\n","                \"Attribute\": attribute,\n","                \"Group\": group,\n","                \"Count\": int(mask.sum()),\n","                \"Selection_Rate\": p.mean(),\n","                \"True_Positive_Rate\": tpr,\n","                \"Mean_Probability\": s.mean(),\n","                \"Observed_Rate\": a.mean(),\n","                \"Calibration_Error\": calibration_error\n","            })\n","\n","    return pd.DataFrame(rows)\n","\n","\n","before = fairness_report(\n","    actual,\n","    baseline_predictions,\n","    probabilities,\n","    groups\n",")\n","\n","\n","def calculate_fairness_gaps(report):\n","\n","    results = []\n","\n","    for attribute in sensitive_attributes:\n","\n","        part = report[\n","            report[\"Attribute\"] == attribute\n","        ]\n","\n","        dp = (\n","            part[\"Selection_Rate\"].max()\n","            - part[\"Selection_Rate\"].min()\n","        )\n","\n","        eo = (\n","            part[\"True_Positive_Rate\"].max()\n","            - part[\"True_Positive_Rate\"].min()\n","        )\n","\n","        calibration = (\n","            part[\"Calibration_Error\"].max()\n","            - part[\"Calibration_Error\"].min()\n","        )\n","\n","        results.append({\n","            \"Attribute\": attribute,\n","            \"Demographic_Parity_Gap\": dp,\n","            \"Equal_Opportunity_Gap\": eo,\n","            \"Calibration_Gap\": calibration\n","        })\n","\n","    return pd.DataFrame(results)\n","\n","\n","before_gaps = calculate_fairness_gaps(before)\n","\n","print(\"\\nFAIRNESS BEFORE MITIGATION\")\n","print(before_gaps.to_string(index=False))\n","\n","\n","# 9. SELECT LARGEST FAIRNESS GAP\n","\n","candidates = []\n","\n","for _, row in before_gaps.iterrows():\n","\n","    candidates.append((\n","        row[\"Attribute\"],\n","        \"Demographic Parity\",\n","        row[\"Demographic_Parity_Gap\"]\n","    ))\n","\n","    candidates.append((\n","        row[\"Attribute\"],\n","        \"Equal Opportunity\",\n","        row[\"Equal_Opportunity_Gap\"]\n","    ))\n","\n","target_attribute, target_metric, largest_gap = max(\n","    candidates, key=lambda x: x[2]\n",")\n","\n","print(\"\\nLARGEST GAP\")\n","print(\"Attribute:\", target_attribute)\n","print(\"Metric:\", target_metric)\n","print(\"Gap:\", largest_gap)\n","\n","\n","# 10. BIAS MITIGATION USING REWEIGHTING\n","\n","# Calculate weights for each combination of:\n","# Target sensitive attribute and actual classification label.\n","\n","train_groups = df.iloc[train_idx][\n","    target_attribute\n","].reset_index(drop=True)\n","\n","training_labels = yc_train.reset_index(drop=True)\n","\n","weight_frame = pd.DataFrame({\n","    \"group\": train_groups,\n","    \"label\": training_labels\n","})\n","\n","p_group = weight_frame[\"group\"].value_counts(normalize=True)\n","p_label = weight_frame[\"label\"].value_counts(normalize=True)\n","\n","p_joint = (\n","    weight_frame.groupby([\"group\", \"label\"])\n","    .size() / len(weight_frame)\n",")\n","\n","weights = []\n","\n","for g, label in zip(\n","    weight_frame[\"group\"],\n","    weight_frame[\"label\"]\n","):\n","\n","    joint_probability = p_joint.loc[(g, label)]\n","\n","    weight = (\n","        p_group.loc[g] * p_label.loc[label]\n","        / joint_probability\n","    )\n","\n","    weights.append(weight)\n","\n","weights = np.asarray(weights)\n","\n","# Train mitigated classifier\n","\n","mitigated_model = RandomForestClassifier(\n","    n_estimators=30,\n","    max_depth=12,\n","    min_samples_leaf=20,\n","    random_state=42,\n","    n_jobs=-1\n",")\n","\n","mitigated_model.fit(\n","    X_train,\n","    yc_train,\n","    sample_weight=weights\n",")\n","\n","after_probabilities = (\n","    mitigated_model.predict_proba(X_test)[:, 1]\n",")\n","\n","after_predictions = (\n","    after_probabilities >= 0.5\n",").astype(int)\n","\n","after = fairness_report(\n","    actual,\n","    after_predictions,\n","    after_probabilities,\n","    groups\n",")\n","\n","after_gaps = calculate_fairness_gaps(after)\n","\n","print(\"\\nFAIRNESS AFTER MITIGATION\")\n","print(after_gaps.to_string(index=False))\n","\n","\n","# 11. BEFORE AND AFTER COMPARISON\n","\n","comparison = before_gaps.merge(\n","    after_gaps,\n","    on=\"Attribute\",\n","    suffixes=(\"_Before\", \"_After\")\n",")\n","\n","before_accuracy = accuracy_score(\n","    yc_test,\n","    baseline_predictions\n",")\n","\n","after_accuracy = accuracy_score(\n","    yc_test,\n","    after_predictions\n",")\n","\n","accuracy_loss = (\n","    (before_accuracy - after_accuracy)\n","    / before_accuracy * 100\n",")\n","\n","metric_column = (\n","    \"Demographic_Parity_Gap\"\n","    if target_metric == \"Demographic Parity\"\n","    else \"Equal_Opportunity_Gap\"\n",")\n","\n","target_after = after_gaps.loc[\n","    after_gaps[\"Attribute\"] == target_attribute,\n","    metric_column\n","].iloc[0]\n","\n","gap_reduction = (\n","    (largest_gap - target_after) / largest_gap * 100\n","    if largest_gap > 0 else 0\n",")\n","\n","print(\"\\nMITIGATION RESULTS\")\n","print(\"Before accuracy:\", before_accuracy)\n","print(\"After accuracy:\", after_accuracy)\n","print(\"Accuracy loss (%):\", accuracy_loss)\n","print(\"Fairness gap reduction (%):\", gap_reduction)\n","\n","success = (\n","    gap_reduction >= 30\n","    and accuracy_loss < 3\n",")\n","\n","print(\"Acceptance criteria met:\", success)\n","\n","\n","# 12. GLOBAL AND LOCAL EXPLAINABILITY USING SHAP\n","\n","print(\"\\nGENERATING SHAP EXPLANATIONS\")\n","\n","sample = X_test.sample(\n","    min(200, len(X_test)),\n","    random_state=42\n",")\n","\n","explainer = shap.TreeExplainer(regression_model)\n","\n","shap_values = explainer(sample)\n","\n","shap.plots.beeswarm(\n","    shap_values,\n","    max_display=12,\n","    show=False\n",")\n","\n","plt.tight_layout()\n","plt.savefig(\"audit_outputs/shap_global.png\")\n","plt.show()\n","\n","shap.plots.waterfall(\n","    shap_values[0],\n","    max_display=12,\n","    show=False\n",")\n","\n","plt.tight_layout()\n","plt.savefig(\"audit_outputs/shap_local.png\")\n","plt.show()\n","\n","# Feature importance\n","\n","importance = pd.DataFrame({\n","    \"Feature\": X.columns,\n","    \"Importance\": regression_model.feature_importances_\n","}).sort_values(\n","    \"Importance\", ascending=False\n",")\n","\n","print(\"\\nTOP IMPORTANT FEATURES\")\n","print(importance.head(15).to_string(index=False))\n","\n","\n","# 13. 30 RED-TEAM EDGE CASES\n","\n","edge_specs = [\n","    (\"Negative electricity\", \"electricity_kwh\", -100),\n","    (\"Extreme electricity\", \"electricity_kwh\", 1000000),\n","    (\"Zero electricity\", \"electricity_kwh\", 0),\n","    (\"Missing electricity\", \"electricity_kwh\", np.nan),\n","    (\"Negative water\", \"water_litres\", -50),\n","    (\"Extreme water\", \"water_litres\", 1000000),\n","    (\"Zero water\", \"water_litres\", 0),\n","    (\"Negative diesel\", \"diesel_litres\", -10),\n","    (\"Extreme diesel\", \"diesel_litres\", 100000),\n","    (\"Missing diesel\", \"diesel_litres\", np.nan),\n","    (\"Month zero\", \"month\", 0),\n","    (\"Month thirteen\", \"month\", 13),\n","    (\"January boundary\", \"month\", 1),\n","    (\"December boundary\", \"month\", 12),\n","    (\"Negative emission factor\", \"emission_factor\", -1),\n","    (\"Extreme emission factor\", \"emission_factor\", 10),\n","    (\"Missing emission factor\", \"emission_factor\", np.nan),\n","    (\"Invalid diesel flag\", \"diesel_missing\", 2),\n","    (\"Invalid meter flag\", \"meter_missing\", -1),\n","    (\"Unseen region\", \"region\", \"unknown\"),\n","    (\"Unseen language\", \"language\", \"unknown\"),\n","    (\"Unseen site\", \"site_id\", \"unknown\"),\n","    (\"All zero energy\", \"all_zero\", 0),\n","    (\"Duplicate record\", \"duplicate\", 0),\n","    (\"High electricity\", \"electricity_kwh\", 500000),\n","    (\"Zero diesel\", \"diesel_litres\", 0),\n","    (\"Zero emission factor\", \"emission_factor\", 0),\n","    (\"Very low electricity\", \"electricity_kwh\", 0.001),\n","    (\"High diesel flag\", \"diesel_missing\", 1),\n","    (\"High meter flag\", \"meter_missing\", 1)\n","]\n","\n","red_team_results = []\n","\n","for i, (name, column, value) in enumerate(edge_specs):\n","\n","    row = X_test.iloc[i].copy()\n","    flags = []\n","\n","    if column == \"region\":\n","        for c in row.index:\n","            if c.startswith(\"region_\"):\n","                row[c] = 0\n","        flags.append(\"Unknown category\")\n","\n","    elif column == \"language\":\n","        for c in row.index:\n","            if c.startswith(\"language_\"):\n","                row[c] = 0\n","        flags.append(\"Unknown category\")\n","\n","    elif column == \"site_id\":\n","        for c in row.index:\n","            if c.startswith(\"site_id_\"):\n","                row[c] = 0\n","        flags.append(\"Unknown category\")\n","\n","    elif column == \"all_zero\":\n","        for c in [\n","            \"electricity_kwh\",\n","            \"water_litres\",\n","            \"diesel_litres\"\n","        ]:\n","            row[c] = 0\n","\n","    elif column == \"duplicate\":\n","        row = X_test.iloc[0].copy()\n","        flags.append(\"Duplicate record\")\n","\n","    else:\n","        row[column] = value\n","\n","    if column == \"electricity_kwh\":\n","        if pd.isna(value) or value < 0:\n","            flags.append(\"Invalid electricity\")\n","        elif value > 50000:\n","            flags.append(\"Extreme electricity\")\n","\n","    if column == \"water_litres\":\n","        if pd.isna(value) or value < 0:\n","            flags.append(\"Invalid water\")\n","\n","    if column == \"diesel_litres\":\n","        if pd.isna(value) or value < 0:\n","            flags.append(\"Invalid diesel\")\n","\n","    if column == \"month\" and value not in range(1, 13):\n","        flags.append(\"Invalid month\")\n","\n","    if column == \"emission_factor\":\n","        if pd.isna(value) or value < 0:\n","            flags.append(\"Invalid emission factor\")\n","\n","    if column in [\"diesel_missing\", \"meter_missing\"]:\n","        if value not in [0, 1]:\n","            flags.append(\"Invalid flag\")\n","\n","    red_team_results.append({\n","        \"Test_Case\": i + 1,\n","        \"Scenario\": name,\n","        \"Validation_Result\": (\n","            \"FLAGGED\" if flags else \"CHECKED\"\n","        ),\n","        \"Issues\": \", \".join(flags) if flags else \"No validation flag\"\n","    })\n","\n","red_team = pd.DataFrame(red_team_results)\n","\n","print(\"\\nRED TEAM RESULTS\")\n","print(red_team.to_string(index=False))\n","print(\"Total test cases:\", len(red_team))\n","\n","\n","# 14. PRIVACY AND COMPLIANCE RISK REGISTER\n","\n","risks = pd.DataFrame([\n","    [\"Demographic data exposure\", \"High\",\n","     \"Data minimisation and restricted access\", \"Privacy Officer\"],\n","    [\"Unauthorised access\", \"High\",\n","     \"Encryption and role-based access\", \"Security Lead\"],\n","    [\"AI discrimination\", \"High\",\n","     \"Regular fairness testing\", \"Responsible AI Lead\"],\n","    [\"Incorrect meter readings\", \"High\",\n","     \"Meter validation and unit checks\", \"Data Engineering Lead\"],\n","    [\"Incorrect emission factors\", \"High\",\n","     \"Verified factor sources and version control\", \"Sustainability Lead\"],\n","    [\"Prediction errors\", \"Medium\",\n","     \"Model monitoring and validation\", \"ML Engineer\"],\n","    [\"Model manipulation\", \"Medium\",\n","     \"Input validation and security testing\", \"Security Lead\"],\n","    [\"Unexplained decisions\", \"Medium\",\n","     \"SHAP and human review\", \"AI Governance Lead\"],\n","    [\"Excessive data retention\", \"Medium\",\n","     \"Retention schedule and secure deletion\", \"Privacy Officer\"],\n","    [\"BRSR reporting errors\", \"High\",\n","     \"Evidence checks and compliance review\", \"Compliance Lead\"]\n","], columns=[\n","    \"Risk\", \"Impact\", \"Control\", \"Owner\"\n","])\n","\n","print(\"\\nRISK REGISTER\")\n","print(risks.to_string(index=False))\n","\n","\n","# 15. MODEL CARD\n","\n","model_card = f\"\"\"\n","RESPONSIBLE AI MODEL CARD\n","\n","Model: Sustainability Energy Prediction Model\n","\n","Purpose:\n","Predict monthly energy consumption for fictional\n","renewable energy facilities.\n","\n","Dataset:\n","400,000 synthetic records.\n","15 fictional sites.\n","12 simulated months.\n","\n","Algorithm:\n","Random Forest Regressor.\n","\n","Performance:\n","MAE: {mae:.3f}\n","RMSE: {rmse:.3f}\n","R2: {r2:.4f}\n","\n","Sensitive attributes:\n","Gender, age group, region and language.\n","\n","Proxy features:\n","Region, language and site identifiers.\n","\n","Mitigation:\n","Reweighing using the largest baseline fairness gap.\n","\n","Target attribute:\n","{target_attribute}\n","\n","Target metric:\n","{target_metric}\n","\n","Fairness gap reduction:\n","{gap_reduction:.2f}%\n","\n","Accuracy loss:\n","{accuracy_loss:.2f}%\n","\n","Limitations:\n","Synthetic dataset only.\n","Not validated on actual facility records.\n","Fairness metrics do not prove absence of discrimination.\n","\n","Intended use:\n","Educational demonstration and research.\n","\n","Not intended for:\n","Automatic high-stakes decisions.\n","\n","Human oversight:\n","Required before any real-world use.\n","\"\"\"\n","\n","with open(\n","    \"audit_outputs/model_card.txt\", \"w\"\n",") as f:\n","    f.write(model_card)\n","\n","\n","# 16. TWO-PAGE AUDIT SUMMARY\n","\n","summary = f\"\"\"\n","RESPONSIBLE AI SUSTAINABILITY AUDIT\n","TWO-PAGE AUDIT SUMMARY\n","\n","1. PROJECT OVERVIEW\n","\n","The project audits a fictional renewable energy\n","developer's AI energy prediction model.\n","\n","The model uses synthetic facility records\n","representing 15 sites and 12 months.\n","\n","2. DATA QUALITY\n","\n","The audit evaluated:\n","- Missing diesel generator logs.\n","- Missing meter readings.\n","- kWh and MWh standardisation.\n","- Historical emission factors.\n","- Data completeness.\n","\n","3. MODEL PERFORMANCE\n","\n","Algorithm: Random Forest Regressor\n","\n","MAE: {mae:.3f}\n","RMSE: {rmse:.3f}\n","R2: {r2:.4f}\n","\n","4. FAIRNESS ASSESSMENT\n","\n","Sensitive attributes:\n","Gender, age group, region and language.\n","\n","Metrics:\n","Demographic parity.\n","Equal opportunity.\n","Calibration error.\n","\n","5. BIAS MITIGATION\n","\n","Method: Reweighing.\n","\n","Target attribute: {target_attribute}\n","Target metric: {target_metric}\n","\n","Fairness gap reduction: {gap_reduction:.2f}%\n","Accuracy loss: {accuracy_loss:.2f}%\n","\n","Acceptance criteria:\n","At least 30% gap reduction and less than\n","3% accuracy loss.\n","\n","Result:\n","{\"TARGETS MET\" if success else \"TARGETS NOT MET - FURTHER TESTING REQUIRED\"}\n","\n","6. EXPLAINABILITY\n","\n","SHAP was used for global and local explanations.\n","Feature importance was reviewed for potential\n","proxy-variable influence.\n","\n","7. PRIVACY AND BRSR\n","\n","The risk register identifies data exposure,\n","unauthorised access, data quality and reporting risks.\n","\n","BRSR applicability and reporting evidence must\n","be independently verified against current SEBI rules.\n","\n","8. RED-TEAM TESTING\n","\n","30 synthetic edge cases were assessed.\n","Input validation issues were documented.\n","\n","9. FINAL RECOMMENDATION\n","\n","This model is an educational prototype.\n","It is not approved for real-world deployment.\n","\n","Further real-data validation, independent fairness\n","review, privacy controls and human oversight\n","are necessary.\n","\n","Audit status: Synthetic prototype.\n","\"\"\"\n","\n","with open(\n","    \"audit_outputs/audit_summary.txt\", \"w\"\n",") as f:\n","    f.write(summary)\n","\n","\n","# 17. SAVE ALL TABLES\n","\n","before.to_csv(\n","    \"audit_outputs/fairness_before.csv\",\n","    index=False\n",")\n","\n","after.to_csv(\n","    \"audit_outputs/fairness_after.csv\",\n","    index=False\n",")\n","\n","comparison.to_csv(\n","    \"audit_outputs/fairness_gap_comparison.csv\",\n","    index=False\n",")\n","\n","risks.to_csv(\n","    \"audit_outputs/risk_register.csv\",\n","    index=False\n",")\n","\n","red_team.to_csv(\n","    \"audit_outputs/red_team_results.csv\",\n","    index=False\n",")\n","\n","importance.to_csv(\n","    \"audit_outputs/feature_importance.csv\",\n","    index=False\n",")\n","\n","\n","# 18. SAVE COMPARISON GRAPH\n","\n","comparison.plot(\n","    x=\"Attribute\",\n","    y=[\n","        \"Demographic_Parity_Gap_Before\",\n","        \"Demographic_Parity_Gap_After\"\n","    ],\n","    kind=\"bar\",\n","    figsize=(10, 5)\n",")\n","\n","plt.title(\"Fairness Before and After Mitigation\")\n","plt.ylabel(\"Demographic Parity Gap\")\n","plt.tight_layout()\n","\n","plt.savefig(\n","    \"audit_outputs/fairness_comparison.png\"\n",")\n","\n","plt.show()\n","\n","\n","# 19. SAVE MODEL FILES\n","\n","joblib.dump(\n","    regression_model,\n","    \"audit_outputs/energy_prediction_model.pkl\"\n",")\n","\n","joblib.dump(\n","    classifier,\n","    \"audit_outputs/baseline_classifier.pkl\"\n",")\n","\n","joblib.dump(\n","    mitigated_model,\n","    \"audit_outputs/mitigated_classifier.pkl\"\n",")\n","\n","\n","# 20. EXPORT DATASET AND NOTEBOOK OUTPUTS\n","\n","df.to_csv(\n","    \"audit_outputs/synthetic_dataset.csv\",\n","    index=False\n",")\n","\n","shutil.make_archive(\n","    \"Responsible_AI_Sustainability_Audit\",\n","    \"zip\",\n","    \"audit_outputs\"\n",")\n","\n","print(\"\\n====================================\")\n","print(\"RESPONSIBLE AI AUDIT COMPLETED\")\n","print(\"====================================\")\n","\n","print(\"Records:\", len(df))\n","print(\"Sites:\", df[\"site_id\"].nunique())\n","print(\"Fairness gap reduction:\", round(gap_reduction, 2), \"%\")\n","print(\"Accuracy loss:\", round(accuracy_loss, 2), \"%\")\n","print(\"Acceptance criteria:\", success)\n","\n","print(\"\\nPROJECT FILES CREATED:\")\n","print(os.listdir(\"audit_outputs\"))\n","\n","print(\"\\nDownload ZIP file in Google Colab:\")\n","\n","try:\n","    from google.colab import files\n","    files.download(\n","        \"Responsible_AI_Sustainability_Audit.zip\"\n","    )\n","except ImportError:\n","    print(\"ZIP saved in current project folder.\")"]},{"cell_type":"markdown","source":[],"metadata":{"id":"VKL9EYTpJWm9"}}]}